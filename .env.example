# Docker Compose: copiar a .env y completar todos los valores utilizados por compose.yaml.
# Si una variable falta o esta vacia, Compose detiene el arranque e indica su nombre.
# Las credenciales de Discord y Google son obligatorias en este Compose.
POSTGRES_DB=codequest2026
POSTGRES_USER=codequest
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

#Modelo de embeddings a utilizar.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REVISION=main
EMBEDDING_SERVICE_URL=http://embeddings:8765/

#Oauth Discord - Requerido
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

#Oauth Google - Opcional, si no se define, el login con Google no estará disponible.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#Groq (https://console.groq.com/keys)
Groq__ApiKey=
Groq__Model="openai/gpt-oss-20b"

# Backend
ConnectionStrings__DefaultConnection: "Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
