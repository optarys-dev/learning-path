# Docker Compose: copiar a .env y completar todos los valores utilizados por compose.yaml.
# Si una variable falta o esta vacia, Compose detiene el arranque e indica su nombre.
# Discord y Groq son obligatorios en este Compose; Google es opcional.
POSTGRES_DB=codequest2026
POSTGRES_USER=codequest
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

#Modelo de embeddings a utilizar.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REVISION=main
EMBEDDING_SERVICE_URL=http://embeddings:8765/

# OAuth Discord - Requerido: https://discord.com/developers/applications
# Crear una aplicación y obtener Client ID y Client Secret en OAuth2.
# Registrar http://localhost:8080/auth/discord/callback en OAuth2 > Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_PATH=/auth/discord/callback
DISCORD_FORCE_HTTPS_CALLBACK=false

# OAuth Google - Opcional: https://console.cloud.google.com/auth/clients
# Crear un cliente de aplicación web y registrar http://localhost:8080/auth/google/callback.
# Si la aplicación está en prueba, agregar al evaluador como usuario de prueba.
# Si no se definen ambas credenciales, el login con Google no estará disponible.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#Groq (https://console.groq.com/keys)
Groq__ApiKey=
Groq__Model="openai/gpt-oss-20b"

# Backend
ConnectionStrings__DefaultConnection="Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
