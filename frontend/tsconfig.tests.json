{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/lib/validation.ts",
    "src/lib/urls.ts",
    "src/lib/api/latestRequest.ts",
    "src/lib/api/parseProblemDetails.ts",
    "src/features/auth/model/parseSession.ts",
    "src/features/catalog/model/parseCatalogPage.ts",
    "src/features/routes/model/*.ts",
    "src/config/navigation.ts",
    "src/i18n/courseLevel.ts",
    "src/i18n/locales/*.ts",
    "src/features/questionnaire/model/validation.ts",
    "src/features/routes/api/paths.ts"
  ]
}
