# Leave empty in local development: Vite proxies API routes through localhost:5173.
VITE_API_BASE_URL=
# Optional only when an absolute API URL is required by a deployment.
# VITE_API_BASE_URL=https://api.example.com
# If using an absolute API URL, set a frontend callback on an allowed origin.
# VITE_GOOGLE_RETURN_URL=https://frontend.example.com/login/callback
# Never put Google ClientSecret in any VITE_* variable.
