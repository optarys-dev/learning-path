# Leave empty in local development: Vite proxies API routes through localhost:5173.
VITE_API_BASE_URL=
# Optional only when an absolute API URL is required by a deployment.
# VITE_API_BASE_URL=https://api.example.com

# Local development only. Set to true in .env.local to use a sample route recommendation.
VITE_USE_ROUTE_MOCK=false
